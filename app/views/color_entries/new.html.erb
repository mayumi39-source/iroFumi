<div style="max-width: 480px; margin: 0 auto; text-align: center;">
  <h1 style="font-size: 2.8rem; color: #ffffff; margin-bottom: 2rem;">今日の色</h1>

  <%= form_with model: @color_entry, local: true do |f| %>
    <div style="margin-bottom: 1.5rem; text-align: left;">
      <label style="display: block; font-size: 1.55rem; color: #0A2C50; margin-bottom: 0.5rem;">日付</label>
      <%= f.date_field :date, value: @color_entry.date,
          style: "width: 100%; border-radius: 0.75rem; border: 1px solid #0A2C50; padding: 0.75rem; font-size: 1.25rem; color: #44403c;" %>
    </div>

    <div style="margin-bottom: 1.5rem; text-align: center;">
      <label style="display: block; font-size: 1.55rem; color: #0A2C50; margin-bottom: 0.5rem;">色を選ぶ</label>
      <div style="position: relative; width: 10rem; height: 10rem; margin: 0 auto;">
        <div id="color-preview" style="width: 10rem; height: 10rem; border-radius: 50%; background: radial-gradient(circle at center, #0008ff 20%, #0008ff99 50%, #0008ff33 75%, transparent 100%), #ffffff; margin: 0 auto;"></div>
        <%= f.color_field :color, value: @color_entry.color || "#0008ff",
            id: "color-picker",
            style: "position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; border-radius: 50%;" %>
      </div>
    </div>

<script>
  const picker = document.getElementById('color-picker');
  const preview = document.getElementById('color-preview');
  picker.addEventListener('input', function() {
    const color = this.value;
    preview.style.background = `radial-gradient(circle at center, ${color} 30%, ${color}99 55%, ${color}33 70%, transparent 100%), #ffffff`;
  });
</script>

    <div style="margin-bottom: 1.5rem; text-align: left;">
      <label style="display: block; font-size: 1.55rem; color: #0A2C50; margin-bottom: 0.5rem;">ひとこと（任意）</label>
      <%= f.text_area :memo, rows: 3, placeholder: "今日の気持ちを少しだけ...",
          style: "width: 100%; border-radius: 0.75rem; border: 1px solid #d4cfc9; padding: 0.75rem; font-size: 1.05rem; color: #44403c; resize: none;" %>
    </div>

    <%= f.submit "記録する",
        style: "width: 100%; background-color: #44403c; color: white; font-size: 1.55rem; padding: 1.3rem; border-radius: 9999px; cursor: pointer; border: none;" %>
  <% end %>
</div>