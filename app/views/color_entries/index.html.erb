<h1 class="text-xl font-medium text-stone-700 mb-6">
  <%= Date.today.strftime("%Y年%m月") %>の記録
</h1>

<div class="grid grid-cols-7 gap-2 mb-8">
  <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
    <% entry = @color_entries.find { |e| e.date == date } %>
    <div class="aspect-square rounded-full flex items-center justify-center text-xs text-stone-400"
         style="background-color: <%= entry ? entry.color : '#f5f5f4' %>;">
      <%= date.day %>
    </div>
  <% end %>
</div>

<div class="text-center">
  <%= link_to "今日の色を記録する", new_color_entry_path,
      class: "inline-block bg-stone-700 text-white text-sm px-6 py-3 rounded-full" %>
</div>