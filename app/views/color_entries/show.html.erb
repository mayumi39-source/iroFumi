<div class="max-w-md mx-auto mt-8">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-xl font-medium text-stone-700">
      <%= @color_entry.date.strftime("%Y年%m月%d日") %>の記録
    </h1>
    <%= link_to "戻る", home_path, class: "text-sm text-stone-400" %>
  </div>

  <div class="rounded-2xl p-8 mb-6 flex items-center justify-center"
       style="background-color: <%= @color_entry.color %>; min-height: 200px;">
  </div>

  <% if @color_entry.memo.present? %>
    <div class="bg-white rounded-2xl p-6 mb-6">
      <p class="text-sm text-stone-600 leading-relaxed"><%= @color_entry.memo %></p>
    </div>
  <% end %>

  <div class="flex gap-3">
    <%= link_to "編集", edit_color_entry_path(@color_entry),
        class: "flex-1 text-center bg-stone-700 text-white text-sm py-3 rounded-full" %>
    <%= link_to "削除", color_entry_path(@color_entry),
        data: { turbo_method: :delete, turbo_confirm: "削除しますか？" },
        class: "flex-1 text-center bg-red-100 text-red-400 text-sm py-3 rounded-full" %>
  </div>
</div>