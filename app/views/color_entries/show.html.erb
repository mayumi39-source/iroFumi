<div style="max-width: 480px; margin: 0 auto; text-align: center;">
  <h1 style="font-size: 2rem; color: #0A2C50; margin-bottom: 2rem;">
    <%= @color_entry.date.strftime("%Y年%m月%d日") %>の記録
  </h1>

  <div style="position: relative; width: 12rem; height: 12rem; margin: 0 auto 2rem;">
    <div style="width: 12rem; height: 12rem; border-radius: 50%; background: radial-gradient(circle at center, <%= @color_entry.color %> 20%, <%= @color_entry.color %>99 50%, <%= @color_entry.color %>33 75%, transparent 100%), #ffffff;"></div>
  </div>

  <% if @color_entry.memo.present? %>
    <div style="background: rgba(255,255,255,0.7); border-radius: 1rem; padding: 1.5rem; margin-bottom: 2rem; text-align: left;">
      <p style="font-size: 1.2rem; color: #0A2C50; line-height: 1.8;"><%= @color_entry.memo %></p>
    </div>
  <% end %>

  <div style="display: flex; gap: 1rem; margin-bottom: 2rem;">
    <%= link_to "編集", edit_color_entry_path(@color_entry),
        style: "flex: 1; text-align: center; background-color: #0A2C50; color: white; font-size: 1.2rem; padding: 0.9rem; border-radius: 9999px; text-decoration: none;" %>
    <%= link_to "削除", color_entry_path(@color_entry),
        data: { turbo_method: :delete, turbo_confirm: "削除しますか？" },
        style: "flex: 1; text-align: center; background-color: rgba(255,255,255,0.7); color: #e57373; font-size: 1.2rem; padding: 0.9rem; border-radius: 9999px; text-decoration: none;" %>
  </div>

  <%= link_to "カレンダーに戻る", home_path,
      style: "font-size: 1.1rem; color: #0A2C50; text-decoration: none; opacity: 0.7;" %>
</div>