<!DOCTYPE html>
<html>
  <head>
    <title>iroFumi</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-stone-50 min-h-screen">
    <nav class="bg-white bg-opacity-10 px-6 py-4 flex justify-between items-center">
      <a href="/" class="text-lg font-medium text-white">iroFumi</a>
      <div>
        <% if user_signed_in? %>
          <%= link_to "今日の色を記録", new_color_entry_path, class: "text-sm text-white mr-4" %>
          <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-sm text-white opacity-60" %>
        <% else %>
          <%= link_to "ログイン", new_user_session_path, class: "text-sm text-white mr-4" %>
          <%= link_to "新規登録", new_user_registration_path, class: "text-sm text-white opacity-60" %>
        <% end %>
      </div>
    </nav>
    <% if notice %>
      <p class="text-center text-sm text-green-600 mt-4"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="text-center text-sm text-red-400 mt-4"><%= alert %></p>
    <% end %>
    <main class="max-w-2xl mx-auto px-4 py-8">
      <%= yield %>
    </main>
  </body>
</html>