<!DOCTYPE html>
<html>
  <head>
  <meta name="turbo-cache-control" content="no-cache">
   <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'Zen Maru Gothic', sans-serif; font-size: 1.5rem; color: #0A2C50; zoom: 0.9; }
    </style>
    <title>iroFumi</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        lucide.createIcons();
      });
    </script>
  </head>
  <body style="min-height: 100vh; position: relative; overflow-x: hidden;">
  <div class="app-bg" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-image: url('https://images.unsplash.com/photo-1514477917009-389c76a86b68?q=80&w=1367&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D'); background-size: cover; background-position: center; opacity: 0.8; z-index: -1;"></div>
    <nav style="padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center;">
      <a href="/" style="font-size: 1.5rem; color: #0A2C50; text-decoration: none;">iroFumi</a>
      <div style="display: flex; gap: 1rem; margin-left: auto;">
        <% if user_signed_in? %>
          <%= link_to "今日の色を記録", new_color_entry_path, style: "font-size: 1.2rem; color: #0A2C50; text-decoration: none;" %>
          <%= button_to "ログアウト", destroy_user_session_path, method: :delete,
            form: { style: "display: flex; align-items: center;" },
            style: "font-size: 1.2rem; color: #0A2C50; text-decoration: none; background: none; border: none; cursor: pointer; font-family: 'Zen Maru Gothic', sans-serif; padding: 0; line-height: 1;" %>
        <% else %>
          <%= link_to "ログイン", new_user_session_path, style: "font-size: 1.2rem; color: #0A2C50; text-decoration: none;" %>
          <%= link_to "新規登録", new_user_registration_path, style: "font-size: 1.2rem; color: #0A2C50; text-decoration: none;" %>
        <% end %>
      </div>
    </nav>
    <% if alert %>
      <div style="max-width: 480px; margin: 1rem auto; padding: 1rem; background: rgba(255, 255, 255, 0.71); border: 2px solid #e17055; border-radius: 1rem; text-align: center;">
        <p style="color: #e17055; font-size: 1.2rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
          <i data-lucide="triangle-alert" style="width: 20px; height: 20px;"></i>
          <%= alert %>
        </p>
      </div>
      <% if notice || params[:notice] %>
        <div style="max-width: 480px; margin: 1rem auto; padding: 1rem; background: rgba(255, 255, 255, 0.71); border: 2px solid #0A2C50; border-radius: 1rem; text-align: center;">
          <p style="color: #0A2C50; font-size: 1.2rem;">
            <%= notice || params[:notice] %>
          </p>
        </div>
      <% end %>
    <% end %>
    <main class="max-w-2xl mx-auto px-4 py-8">
      <%= yield %>
    </main>
    <footer style="text-align: center; padding: 2rem; margin-top: 3rem;">
      <div style="display: flex; justify-content: center; gap: 2rem;">
        <%= link_to "利用規約", terms_path, style: "font-size: 1.2rem; color: #0A2C50; text-decoration: none; opacity: 0.7;" %>
        <%= link_to "プライバシーポリシー", privacy_path, style: "font-size: 1.2rem; color: #0A2C50; text-decoration: none; opacity: 0.7;" %>
      </div>
      <p style="font-size: 0.9rem; color: #0A2C50; opacity: 0.5; margin-top: 1rem;">© 2026 iroFumi</p>
    </footer>
  </body>
</html>