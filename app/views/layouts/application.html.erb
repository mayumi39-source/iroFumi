<!DOCTYPE html>
<html>
  <head>
   <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'Zen Maru Gothic', sans-serif; font-size: 1.5rem; color: #0A2C50; zoom: 0.9; }
    </style>
    <title>iroFumi</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body style="min-height: 100vh; position: relative;">
  <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-image: url('https://images.unsplash.com/photo-1514477917009-389c76a86b68?q=80&w=1367&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D'); background-size: cover; background-position: center; opacity: 0.8; z-index: -1;"></div>
    <nav style="padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center;">
      <a href="/" style="font-size: 1.5rem; color: #0A2C50; text-decoration: none;">iroFumi</a>
      <div style="display: flex; gap: 1rem; margin-left: auto;">
        <% if user_signed_in? %>
          <%= link_to "今日の色を記録", new_color_entry_path, style: "font-size: 1.2rem; color: #0A2C50; text-decoration: none;" %>
          <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, style: "font-size: 1.2rem; color: #0A2C50; text-decoration: none; opacity: 0.6;" %>
        <% else %>
          <%= link_to "ログイン", new_user_session_path, style: "font-size: 1.2rem; color: #0A2C50; text-decoration: none;" %>
          <%= link_to "新規登録", new_user_registration_path, style: "font-size: 1.2rem; color: #0A2C50; text-decoration: none;" %>
        <% end %>
      </div>
    </nav>
    <% if notice %>
      <p class="text-center text-sm text-green-600 mt-4"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="text-center text-sm text-red-400 mt-4"><%= alert %></p>
    <% end %>
    <main class="max-w-2xl mx-auto px-4 py-8">
      <%= yield %>
    </main>
  </body>
</html>