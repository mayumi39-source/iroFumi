<div class="max-w-md mx-auto mt-8">
  <h2 class="text-xl font-medium text-stone-700 mb-6">新規登録</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="mb-4">
      <%= f.label :email, "メールアドレス", class: "block text-sm text-stone-600 mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
          class: "w-full rounded-xl border border-stone-200 p-3 text-sm text-stone-700" %>
    </div>

    <div class="mb-4">
      <%= f.label :password, "パスワード", class: "block text-sm text-stone-600 mb-1" %>
      <%= f.password_field :password, autocomplete: "new-password",
          class: "w-full rounded-xl border border-stone-200 p-3 text-sm text-stone-700" %>
      <% if @minimum_password_length %>
        <p class="text-xs text-stone-400 mt-1"><%= @minimum_password_length %>文字以上</p>
      <% end %>
    </div>

    <div class="mb-4">
      <%= f.label :password_confirmation, "パスワード（確認）", class: "block text-sm text-stone-600 mb-1" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password",
          class: "w-full rounded-xl border border-stone-200 p-3 text-sm text-stone-700" %>
    </div>

    <div class="mt-6">
      <%= f.submit "登録する",
          class: "w-full bg-stone-700 text-white text-sm py-3 rounded-full cursor-pointer" %>
    </div>
  <% end %>

  <div class="mt-4 text-center text-sm text-stone-500">
    <%= render "devise/shared/links" %>
  </div>
</div>